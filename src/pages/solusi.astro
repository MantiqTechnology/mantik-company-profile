---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Solusi Digital Terpadu - PT Mantik Teknologi Nusantara"
  description="Eksplorasi mendalam 3 pilar solusi teknologi Mantik: Business & Enterprise Solutions, Digital Platforms, serta Data & Intelligent Technology."
>
  <Navbar />

  <main class="pt-20 bg-white min-h-screen overflow-hidden">
    
    <!-- ==============================================
         HERO SECTION SOLUSI
    =============================================== -->
    <section class="py-20 lg:py-24 bg-[#181a20] text-white relative">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px]"></div>
      
      <div class="max-w-6xl mx-auto px-6 text-center relative z-10 flex flex-col items-center">
        <!-- Eyebrow -->
        <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/20 mb-6">
          <span class="text-xs sm:text-[13px] font-medium text-red-200 tracking-tight">
            Our Solution Architecture
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-[3.25rem] font-medium tracking-tight text-white leading-[1.2] mb-6 max-w-4xl">
          Tiga Pilar Solusi Digital Untuk Mentransformasi Bisnis Anda
        </h1>

        <p class="text-sm sm:text-base lg:text-lg font-light text-zinc-300 max-w-2xl leading-relaxed">
          Dari penguatan fondasi sistem internal perusahaan, pembangunan platform interaksi pelanggan, hingga pemanfaatan data dan kecerdasan buatan.
        </p>
      </div>
    </section>


    <!-- ==============================================
         SECTION 01: BUSINESS & ENTERPRISE SOLUTIONS
    =============================================== -->
    <section id="enterprise" class="py-24 lg:py-32 bg-white relative border-b border-zinc-100">
      <div class="max-w-6xl mx-auto px-6">
        
        <!-- Header Section -->
        <div class="flex items-center justify-between pb-6 mb-12 border-b border-zinc-100">
          <span class="text-xs font-mono tracking-widest text-[#851919] uppercase">
            Pilar 01 |
             Core Architecture
          </span>
          <span class="text-2xl sm:text-3xl font-bold font-mono text-zinc-200">01</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Sisi Kiri: Teks & Cakupan (7 Kolom) -->
          <div class="lg:col-span-7 flex flex-col">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-medium tracking-tight text-zinc-900 leading-tight mb-6">
              Business & Enterprise Solutions
            </h2>

            <p class="text-[15px] sm:text-base font-light text-zinc-700 leading-relaxed mb-6">
              Mengintegrasikan seluruh divisi dan proses operasional ke dalam satu ekosistem yang kohesif. Kami mengeliminasi data yang tersebar antar departemen, memastikan setiap alur persetujuan, pergerakan barang, dan pencatatan finansial berjalan secara akurat dan terpantau secara real-time.
            </p>

            <!-- 6 Modul Utama (ERP, CRM, HRM, Finance, Inventory, Enterprise System) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 mt-4 pt-6 border-t border-zinc-100">
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">ERP System</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Otomasi alur operasional</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">CRM System</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Manajemen pipeline klien</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">HRM & Payroll</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">SDM, absensi & gaji</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">Finance System</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Faktur, kas & neraca</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">Inventory Tracking</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Stok gudang multi-cabang</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">Enterprise System</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Arsitektur terintegrasi</span>
              </div>
            </div>

            <!-- Tombol Aksi -->
            <div class="mt-8">
              <a 
                href="/layanan/enterprise" 
                class="inline-flex items-center gap-2 text-sm font-medium text-[#851919] hover:underline"
              >
                <span>Pelajari Detail Layanan Enterprise</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Sisi Kanan: Visual & Balok Asimetris (5 Kolom) -->
          <div class="lg:col-span-5 relative">
            <div class="relative w-full max-w-md mx-auto">
              <div class="absolute -top-5 -left-5 w-36 h-24 bg-[#851919] z-0"></div>
              <div class="relative z-10 overflow-hidden shadow-xl bg-zinc-200">
                <img 
                  src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=1000&auto=format&fit=crop" 
                  alt="Enterprise Architecture" 
                  class="w-full h-[360px] object-cover"
                />
              </div>
              <div class="absolute -bottom-5 -right-5 w-36 h-20 bg-[#232325] z-0"></div>
            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- ==============================================
         SECTION 02: DIGITAL PLATFORMS (Dark Navy Theme)
    =============================================== -->
    <section id="digital-platforms" class="py-24 lg:py-32 bg-[#1f263c] text-white relative">
      <div class="max-w-6xl mx-auto px-6">
        
        <!-- Header Section -->
        <div class="flex items-center justify-between pb-6 mb-12 border-b border-white/10">
          <span class="text-xs font-mono tracking-widest text-[#e05353] uppercase">
            Pilar 02 | Customer Facing Experience
          </span>
          <span class="text-2xl sm:text-3xl font-bold font-mono text-white/20">02</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Sisi Kiri: Visual (5 Kolom) - Posisi Zigzag -->
          <div class="lg:col-span-5 relative order-2 lg:order-1">
            <div class="relative w-full max-w-md mx-auto lg:ml-0">
              <div class="absolute -top-5 -right-5 w-36 h-24 bg-[#e05353] z-0"></div>
              <div class="relative z-10 overflow-hidden shadow-2xl bg-zinc-900">
                <img 
                  src="https://images.unsplash.com/photo-1637502875124-eb4a9843a2fa?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTZ8fHdlYnNpdGV8ZW58MHx8MHx8fDA%3D" 
                  alt="Digital Platforms Development" 
                  class="w-full h-[360px] object-cover opacity-90"
                />
              </div>
              <div class="absolute -bottom-5 -left-5 w-36 h-20 bg-white/10 z-0"></div>
            </div>
          </div>

          <!-- Sisi Kanan: Teks & Cakupan (7 Kolom) -->
          <div class="lg:col-span-7 flex flex-col order-1 lg:order-2">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-medium tracking-tight text-white leading-tight mb-6">
              Digital Platforms
            </h2>

            <p class="text-[15px] sm:text-base font-light text-zinc-300 leading-relaxed mb-6">
              Membangun gerbang digital interaktif yang menghubungkan produk dan layanan Anda langsung ke tangan pengguna akhir. Kami fokus pada kecepatan akses, keamanan transaksi, dan pengalaman antarmuka yang mempermudah interaksi pengguna.
            </p>

            <!-- 4 Komponen (Website, E-Commerce, Customer Portal, Mobile App) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mt-4 pt-6 border-t border-white/10">
              <div class="p-4 bg-white/5 border border-white/10 rounded-xs">
                <span class="text-xs font-medium text-white block">Modern Corporate Website</span>
                <span class="text-[11px] font-light text-zinc-400 block mt-1">Performa tinggi, SEO solid, dan representasi brand kredibel.</span>
              </div>
              <div class="p-4 bg-white/5 border border-white/10 rounded-xs">
                <span class="text-xs font-medium text-white block">E-Commerce Ecosystem</span>
                <span class="text-[11px] font-light text-zinc-400 block mt-1">Katalog produk dinamis terhubung ke payment & kurir otomatis.</span>
              </div>
              <div class="p-4 bg-white/5 border border-white/10 rounded-xs">
                <span class="text-xs font-medium text-white block">Dedicated Customer Portal</span>
                <span class="text-[11px] font-light text-zinc-400 block mt-1">Layanan mandiri klien: tiket bantuan, tagihan, dan riwayat akun.</span>
              </div>
              <div class="p-4 bg-white/5 border border-white/10 rounded-xs">
                <span class="text-xs font-medium text-white block">Cross-Platform Mobile App</span>
                <span class="text-[11px] font-light text-zinc-400 block mt-1">Aplikasi iOS & Android dengan sinkronisasi data real-time.</span>
              </div>
            </div>

            <!-- Tombol Aksi -->
            <div class="mt-8 flex gap-4">
              <a 
                href="/layanan/custom-web-development" 
                class="inline-flex items-center gap-1.5 text-xs font-medium text-[#e05353] hover:text-white transition-colors"
              >
                <span>Web Dev</span> &rarr;
              </a>
              <a 
                href="/layanan/aplikasi-mobile" 
                class="inline-flex items-center gap-1.5 text-xs font-medium text-[#e05353] hover:text-white transition-colors"
              >
                <span>Mobile App</span> &rarr;
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- ==============================================
         SECTION 03: DATA & INTELLIGENT TECHNOLOGY
    =============================================== -->
    <section id="data-ai" class="py-24 lg:py-32 bg-white relative">
      <div class="max-w-6xl mx-auto px-6">
        
        <!-- Header Section -->
        <div class="flex items-center justify-between pb-6 mb-12 border-b border-zinc-100">
          <span class="text-xs font-mono tracking-widest text-[#851919] uppercase">
            Pilar 03 | Intelligence & Analytics
          </span>
          <span class="text-2xl sm:text-3xl font-bold font-mono text-zinc-200">03</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Sisi Kiri: Teks & Cakupan (7 Kolom) -->
          <div class="lg:col-span-7 flex flex-col">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-medium tracking-tight text-zinc-900 leading-tight mb-6">
              Data & Intelligent Technology
            </h2>

            <p class="text-[15px] sm:text-base font-light text-zinc-700 leading-relaxed mb-6">
              Mengubah tumpukan data transaksi mentah menjadi wawasan bisnis yang tajam dan otomatisasi cerdas. Kami mengintegrasikan machine learning, jaringan sensor Internet of Things (IoT), serta dashboard analitik agar keputusan bisnis diambil berdasarkan bukti data, bukan asumsi.
            </p>

            <!-- 5 Komponen (AI, Data Solutions, IoT, Business Analysis, Data Analyst) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 mt-4 pt-6 border-t border-zinc-100">
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">AI Integration</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">LLM & pemrosesan dokumen cerdas</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">Data Solutions</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Pipeline ETL & data warehouse</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">IoT Telemetry</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Monitoring sensor hardware fisik</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs">
                <span class="text-xs font-medium text-zinc-900 block">Business Analysis</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Pemetaan efisiensi proses kerja</span>
              </div>
              <div class="p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-xs col-span-2 sm:col-span-2">
                <span class="text-xs font-medium text-zinc-900 block">Data Analyst & BI Dashboard</span>
                <span class="text-[11px] font-light text-zinc-500 block mt-0.5">Visualisasi interaktif metrik kunci & KPI untuk direksi</span>
              </div>
            </div>

            <!-- Tombol Aksi -->
            <div class="mt-8 flex gap-4">
              <a 
                href="/layanan/integrasi-ai" 
                class="inline-flex items-center gap-1.5 text-xs font-medium text-[#851919] hover:underline"
              >
                <span>AI Integration</span> &rarr;
              </a>
              <a 
                href="/layanan/business-intelligence" 
                class="inline-flex items-center gap-1.5 text-xs font-medium text-[#851919] hover:underline"
              >
                <span>Business Intelligence</span> &rarr;
              </a>
            </div>
          </div>

          <!-- Sisi Kanan: Visual & Balok Asimetris (5 Kolom) -->
          <div class="lg:col-span-5 relative">
            <div class="relative w-full max-w-md mx-auto">
              <div class="absolute -top-5 -left-5 w-36 h-24 bg-[#851919] z-0"></div>
              <div class="relative z-10 overflow-hidden shadow-xl bg-zinc-200">
                <img 
                  src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?q=80&w=1000&auto=format&fit=crop" 
                  alt="Data and Intelligent Technology Analysis" 
                  class="w-full h-[360px] object-cover"
                />
              </div>
              <div class="absolute -bottom-5 -right-5 w-36 h-20 bg-[#1f263c] z-0"></div>
            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- ==============================================
         CTA PENUTUP
    =============================================== -->
    <section class="py-20 bg-zinc-50 border-t border-zinc-200/80 text-center">
      <div class="max-w-4xl mx-auto px-6">
        <h3 class="text-2xl sm:text-3xl font-medium text-zinc-900 mb-4">
          Siap Mengimplementasikan Solusi di Perusahaan Anda?
        </h3>
        <p class="text-sm sm:text-base font-light text-zinc-600 max-w-xl mx-auto mb-8">
          Konsultasikan tantangan bisnis Anda. Tim Mantik siap membantu menentukan pendekatan arsitektur teknologi yang paling efektif.
        </p>
        <a 
          href="https://wa.me/6287736344743" 
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-3.5 bg-[#851919] hover:bg-[#6c1414] text-white text-sm font-medium rounded-xs shadow-xs transition-all inline-block"
        >
          Konsultasi Solusi via WhatsApp
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>