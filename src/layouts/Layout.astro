---
import '../styles/global.css';
import WhatsappButton from '../components/WhatsappButton.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Mantik - Technology Solutions Partner", 
  description = "Mengubah Tantangan Bisnis Menjadi Solusi Digital." 
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Plus Jakarta Sans (Weights: 300, 400, 500, 600) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link 
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" 
      rel="stylesheet"
    />
  </head>
  <WhatsappButton />
  <body class="bg-white text-zinc-900 antialiased selection:bg-[#851919] selection:text-white min-h-screen flex flex-col">
    <slot />
  </body>
</html>

<style is:global>
  /* Menerapkan font Plus Jakarta Sans secara default ke seluruh halaman */
  body {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
</style>