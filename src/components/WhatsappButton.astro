---
const phoneNumber = "6287736344743";
const defaultMessage = encodeURIComponent(
  "Halo Tim Mantik, saya ingin konsultasi kebutuhan teknologi dan sistem digital untuk perusahaan saya."
);
const waLink = `https://wa.me/${phoneNumber}?text=${defaultMessage}`;
---

<!-- Container Floating Widget -->
<aside 
  aria-label="Konsultasi WhatsApp Mantik" 
  class="fixed bottom-6 right-6 z-50 group flex flex-col items-end select-none"
>

  <!-- ========================================================
       KARTU INFORMASI SEDERHANA (Hanya Muncul Saat di-Hover)
  ========================================================= -->
  <div 
    class="absolute bottom-full right-0 mb-3 w-70 p-4 bg-white rounded-xl shadow-xl border border-zinc-200/90 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 ease-out"
  >
    <!-- Header Kartu: Status Online -->
    <div class="flex items-center justify-between pb-2.5 mb-2.5 border-b border-zinc-100">
      <span class="text-xs font-medium text-zinc-900 tracking-tight">
        Konsultasi Solusi Digital
      </span>
      <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Online
      </span>
    </div>

    <!-- Informasi Ringkas -->
    <p class="text-xs text-zinc-600 font-light leading-relaxed mb-3">
      Diskusikan rencana pembuatan sistem, platform web, aplikasi mobile, atau estimasi anggaran proyek Anda bersama tim kami.
    </p>

    <!-- Catatan Respons -->
    <div class="flex items-center justify-between text-[11px] text-zinc-400 font-light pt-2 border-t border-zinc-50">
      <span>Respons cepat via WhatsApp</span>
      <span class="text-[#851919] font-medium group-hover:translate-x-0.5 transition-transform">
        Klik untuk chat &rarr;
      </span>
    </div>

    <!-- Ekor Segitiga Balon -->
    <div class="absolute -bottom-1.5 right-8 w-3 h-3 bg-white border-r border-b border-zinc-200/90 rotate-45"></div>
  </div>


  <!-- ========================================================
       TOMBOL FLOATING UTAMA (Merah Mantik & Jelas)
  ========================================================= -->
 <a
    href={waLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp Konsultasi Proyek"
    class="relative overflow-hidden flex items-center gap-3.5 pl-4 pr-5 py-3 rounded-2xl bg-gradient-to-r from-[#851919] to-[#9e2424] text-white shadow-[0_10px_25px_-5px_rgba(133,25,25,0.45)] hover:shadow-[0_18px_35px_-5px_rgba(133,25,25,0.65)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 border border-white/20"
  >

  <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/25 to-transparent pointer-events-none"></div>
    
    <div class="w-12 h-12 rounded-xl bg-white text-[#851919] flex items-center justify-center shrink-0 shadow-sm transition-transform duration-300 group-hover:rotate-6 group-hover:scale-105">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 fill-current"
        viewBox="0 0 24 24"
      >
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </div>

    <!-- Teks Ajakan yang Jelas & Tegas -->
    <div class="flex flex-col text-left">
      <span class="text-[13px] font-medium tracking-tight text-white leading-tight">
        Tanya Solusi Digital
      </span>
      <span class="text-[11px] font-light text-red-100 flex items-center gap-1.5 mt-0.5">
        <span>Chat WhatsApp Langsung</span>
      </span>
    </div>

    <!-- Panah Geser Interaktif -->
    <div class="ml-1 w-6 h-6 rounded-full bg-white/10 flex items-center justify-center transition-all duration-300 group-hover:bg-white group-hover:text-[#851919] group-hover:translate-x-1">
      <svg 
        xmlns="http://www.w3.org/2000/svg" 
        class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </div>

  </a>

</aside>