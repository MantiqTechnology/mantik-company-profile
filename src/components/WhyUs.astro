---
---

<section id="whyus" class="py-20 lg:py-28 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
      
      <!-- Kolom Kiri: Foto Analisis Bisnis & Balok Arang Gelap (#232325) -->
      <div class="lg:col-span-6 relative flex items-center justify-center lg:justify-start pb-8 lg:pb-0 pr-0 lg:pr-6">
        <div class="relative w-full max-w-lg">
          
          <!-- Balok Gelap (#232325) di Sudut Kiri Bawah -->
          <div class="absolute -bottom-6 -left-6 sm:-bottom-8 sm:-left-8 w-40 sm:w-52 h-44 sm:h-56 bg-[#232325] z-0"></div>

          <!-- Wadah Gambar Utama -->
          <div class="relative z-10 overflow-hidden shadow-lg bg-zinc-200 group">
            <img
              src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?q=80&w=1000&auto=format&fit=crop"
              alt="Business and Data Analysis Discussion"
              class="w-full h-[340px] sm:h-[420px] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </div>

        </div>
      </div>

      <!-- Kolom Kanan: Blok Merah Mantik (#851919) dengan Teks -->
      <div class="lg:col-span-6 bg-[#851919] px-8 py-12 sm:px-12 sm:py-16 flex flex-col justify-center relative z-20">
        
        <!-- Pill Badge: Why Mantik -->
        <div class="inline-flex items-center self-start px-4 py-1.5 rounded-full bg-white shadow-xs mb-8">
          <span class="text-xs sm:text-[13px] font-medium text-[#851919] tracking-tight">
            Why Mantik
          </span>
        </div>

        <!-- Judul Utama (Putih, font-medium) -->
        <h2 class="text-2xl sm:text-3xl lg:text-[2.35rem] font-bold tracking-tight text-white leading-[1.25] mb-6">
          The Right Technology. <br class="hidden sm:inline" />
          Built For Your Business
        </h2>

        <!-- Deskripsi Paragraf -->
        <p class="text-[14px] sm:text-[15px] font-light text-zinc-100/90 leading-relaxed max-w-xl">
          Kami tidak percaya bahwa solusi terbaik adalah solusi yang paling kompleks. Kami percaya bahwa teknologi harus dipilih berdasarkan masalah yang ingin diselesaikan, kebutuhan bisnis, pengalaman pengguna, keamanan, skalabilitas, dan kemampuan untuk berkembang dalam jangka panjang.
        </p>

      </div>

    </div>
  </div>
</section>