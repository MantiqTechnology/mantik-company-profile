---
---

<section class="py-24 lg:py-32 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Kolom Kiri: Narasi & Filosofi Teknologi -->
      <div class="lg:col-span-7 flex flex-col items-start lg:pr-6">
        
        <!-- Pill Badge -->
        <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-[#fcedec] border border-[#f5d0cf] mb-6">
          <span class="text-xs sm:text-[13px] font-medium text-[#851919]">
            Technology Philosophy
          </span>
        </div>

        <!-- Judul Utama (Merah Mantik, font-medium) -->
        <h2 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-bold text-[#851919] leading-[1.2] tracking-tight mb-8">
          Technology Should Solve <br class="hidden sm:inline" />
          Problems, Not Create <br class="hidden sm:inline" />
          Them
        </h2>

        <!-- Deskripsi Paragraf -->
        <p class="text-[15px] sm:text-base font-normal text-zinc-800 leading-relaxed text-justify sm:text-left">
          Kami memilih teknologi berdasarkan apa yang benar-benar dibutuhkan bisnis, bukan sekadar mengikuti tren. Setiap solusi dirancang dengan mempertimbangkan reliability, security, scalability, maintainability, user experience, dan business value, sehingga teknologi dapat bekerja dengan baik hari ini dan tetap relevan ketika kebutuhan organisasi berkembang.
        </p>

      </div>

      <!-- Kolom Kanan: Foto Laptop & Workspace -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-md lg:max-w-none overflow-hidden shadow-lg bg-zinc-100 group">
          <img
            src="https://images.unsplash.com/photo-1587614382346-4ec70e388b28?q=80&w=1000&auto=format&fit=crop"
            alt="Software Development and Business Solution Working on Laptop"
            class="w-full h-[380px] sm:h-[450px] object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </div>
      </div>

    </div>
  </div>
</section>