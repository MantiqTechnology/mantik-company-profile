---
---

<section id="cta" class="py-24 sm:py-32 bg-white relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-6 text-center flex flex-col items-center">
    
    <!-- Pill Badge: Let's Build What's Next -->
    <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-[#fcedec] border border-[#f5d0cf] mb-8">
      <span class="text-xs sm:text-[13px] font-medium text-[#851919] tracking-tight">
        Let's Build What's Next
      </span>
    </div>

    <!-- Judul Utama (Merah Mantik, font-medium) -->
    <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-bold tracking-tight text-[#851919] leading-[1.2] mb-6">
      Punya Tantangan Bisnis <br class="hidden sm:inline" />
      Yang Ingin Diselesaikan?
    </h2>

    <!-- Deskripsi Paragraf -->
    <p class="text-[15px] sm:text-base font-normal text-zinc-700 leading-relaxed max-w-2xl mx-auto mb-10">
      Ceritakan kebutuhan atau tantangan yang sedang Anda hadapi. Bersama Mantik, kita akan menemukan pendekatan teknologi yang tepat untuk membantu bisnis Anda bekerja lebih baik.
    </p>

    <!-- Tombol Aksi Bersandingan -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
      
      <!-- Tombol 1: Mulai Diskusi (Outline) -->
      <a
        href="#kontak"
        class="w-full sm:w-48 py-3.5 px-6 border border-[#851919] text-[#851919] hover:bg-[#851919] hover:text-white text-sm font-medium tracking-wide transition-all duration-300 rounded-xs shadow-xs text-center hover:-translate-y-0.5"
      >
        Mulai Diskusi
      </a>

      <!-- Tombol 2: Jelajahi Solusi (Solid) -->
      <a
        href="#solusi"
        class="w-full sm:w-48 py-3.5 px-6 bg-[#851919] hover:bg-[#6c1414] text-white text-sm font-medium tracking-wide transition-all duration-300 rounded-xs shadow-xs text-center hover:-translate-y-0.5"
      >
        Jelajahi Solusi
      </a>

    </div>

  </div>
</section>