---
const servicesList = [
  { name: "Enterprise", href: "/layanan/enterprise", desc: "Sistem bisnis modular skala enterprise" },
  { name: "Custom Web Development", href: "/layanan/custom-web-development", desc: "Platform web performa tinggi & responsif" },
  { name: "Aplikasi Mobile", href: "/layanan/aplikasi-mobile", desc: "iOS & Android dengan UX intuitif" },
  { name: "Aplikasi Desktop", href: "/layanan/aplikasi-desktop", desc: "Software operasional andal & aman" },
  { name: "Integrasi AI", href: "/layanan/integrasi-ai", desc: "Automasi cerdas berbasis model AI" },
  { name: "IoT", href: "/layanan/iot", desc: "Telemetri sensor & konektivitas hardware" },
  { name: "Cyber Security", href: "/layanan/cyber-security", desc: "Audit keamanan & perlindungan data" },
  { name: "Data Analyst", href: "/layanan/data-analyst", desc: "Pengolahan & analisa data bisnis" },
  { name: "Business Intelligence", href: "/layanan/business-intelligence", desc: "Dashboard interaktif & visualisasi KPI" },
];
---

<header class="fixed top-0 left-0 w-full z-50 bg-white/95 backdrop-blur-sm border-b border-zinc-100 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-20 h-20 flex items-center justify-between relative">
    
    <!-- 1. Logo Brand (Sisi Kiri) -->
    <a href="/" class="flex items-center gap-2 group z-20">
      <img 
        src="/images/logo.png" 
        alt="Mantik Logo" 
        class="h-8 md:h-9 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
      />
      <!-- Fallback text jika file logo belum diletakkan di public/images -->
      <span class="hidden text-xl font-medium tracking-tight text-zinc-900">
        <span class="text-[#851919]">M</span>antik
      </span>
    </a>

    <!-- 2. Navigasi Menu Desktop (Rata Tengah) -->
    <nav class="hidden lg:flex absolute left-1/2 -translate-x-1/2 items-center gap-6 xl:gap-8">
      <a href="/" class="text-[14px] xl:text-[15px] font-normal text-zinc-800 hover:text-[#851919] transition-colors">
        Beranda
      </a>
      
      <a href="/about" class="text-[14px] xl:text-[15px] font-normal text-zinc-800 hover:text-[#851919] transition-colors">
        Tentang
      </a>

      <!-- MENU LAYANAN DENGAN HOVER SUBMENU -->
      <div class="relative group py-6">
        <button 
          type="button"
          class="flex items-center gap-1 text-[14px] xl:text-[15px] font-normal text-zinc-800 group-hover:text-[#851919] transition-colors cursor-pointer"
        >
          <span>Layanan</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Box -->
        <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 absolute top-full left-1/2 -translate-x-1/2 w-80 pt-1 pointer-events-none group-hover:pointer-events-auto">
          <div class="bg-white border border-zinc-100 shadow-xl rounded-xs p-2 grid grid-cols-1 gap-1">
            {servicesList.map((service) => (
              <a 
                href={service.href} 
                class="px-3.5 py-2.5 rounded-xs hover:bg-[#fcedec]/60 transition-colors group/item block"
              >
                <div class="text-[14px] font-medium text-zinc-800 group-hover/item:text-[#851919]">
                  {service.name}
                </div>
                <div class="text-[11px] text-zinc-500 font-light truncate">
                  {service.desc}
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/solusi" class="text-[14px] xl:text-[15px] font-normal text-zinc-800 hover:text-[#851919] transition-colors">
        Solusi
      </a>
      
      <a href="/proyek" class="text-[14px] xl:text-[15px] font-normal text-zinc-800 hover:text-[#851919] transition-colors">
        Proyek
      </a>
      
      <a href="/#kontak" class="text-[14px] xl:text-[15px] font-normal text-zinc-800 hover:text-[#851919] transition-colors">
        Kontak
      </a>
    </nav>

    <!-- 3. Dua Tombol di Ujung Kanan (Desktop) -->
    <div class="hidden md:flex items-center gap-3 z-20">
      <!-- Tombol 1: Hubungi Kami (Outline) -->
      <a 
        href="/#kontak"
        class="px-4 py-2 text-[13px] font-medium text-zinc-700 hover:text-[#851919] border border-zinc-200 hover:border-[#851919] rounded-xs transition-all duration-200"
      >
        Hubungi Kami
      </a>

      <!-- Tombol 2: Konsultasi via WhatsApp (Solid Red) -->
      <a 
        href="https://wa.me/6287736344743" 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-4 py-2 text-[13px] font-medium text-white bg-[#851919] hover:bg-[#6c1414] rounded-xs transition-all duration-200 shadow-xs flex items-center gap-1.5"
      >
        <!-- Icon WhatsApp Sederhana -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Konsultasi</span>
      </a>
    </div>

    <!-- Tombol Hamburger Mobile -->
    <button 
      id="menu-toggle-btn"
      type="button" 
      aria-label="Toggle navigation menu" 
      class="lg:hidden p-2 text-zinc-800 hover:text-[#851919] focus:outline-none z-20 transition-colors"
    >
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

  </div>

  <!-- Dropdown Menu Mobile -->
  <div 
    id="mobile-dropdown" 
    class="hidden lg:hidden bg-white/98 backdrop-blur-md border-b border-zinc-200 px-6 py-6 shadow-xl max-h-[85vh] overflow-y-auto"
  >
    <nav class="flex flex-col space-y-3">
      <a href="/" class="text-base font-normal text-zinc-800 py-2 border-b border-zinc-100">Beranda</a>
      <a href="/about" class="text-base font-normal text-zinc-800 py-2 border-b border-zinc-100">Tentang</a>
      
      <!-- Sub-menu Akordeon Layanan di Mobile -->
      <div class="border-b border-zinc-100 py-2">
        <button id="mobile-sub-btn" class="flex items-center justify-between w-full text-base font-normal text-zinc-800">
          <span>Layanan</span>
          <svg id="sub-arrow" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-sub-menu" class="hidden pl-3 pt-2 space-y-2 mt-1 bg-zinc-50/70 p-2 rounded-xs">
          {servicesList.map((service) => (
            <a href={service.href} class="block text-sm font-light text-zinc-700 py-1.5 hover:text-[#851919]">
              • {service.name}
            </a>
          ))}
        </div>
      </div>

      <a href="/solusi" class="text-base font-normal text-zinc-800 py-2 border-b border-zinc-100">Solusi</a>
      <a href="/proyek" class="text-base font-normal text-zinc-800 py-2 border-b border-zinc-100">Proyek</a>
      <a href="/#kontak" class="text-base font-normal text-zinc-800 py-2 border-b border-zinc-100">Kontak</a>

      <!-- 2 Tombol Aksi Versi Mobile -->
      <div class="pt-4 flex flex-col gap-2.5">
        <a 
          href="/#kontak"
          class="w-full py-2.5 text-center text-sm font-medium text-zinc-800 border border-zinc-300 rounded-xs hover:border-[#851919]"
        >
          Hubungi Kami
        </a>
        <a 
          href="https://wa.me/6287736344743" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full py-2.5 text-center text-sm font-medium text-white bg-[#851919] hover:bg-[#6c1414] rounded-xs shadow-xs flex items-center justify-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Konsultasi WhatsApp</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const dropdown = document.getElementById('mobile-dropdown');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  toggleBtn?.addEventListener('click', () => {
    const isClosed = dropdown?.classList.toggle('hidden');
    if (isClosed) {
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });

  // Toggle Sub-menu Layanan di Mobile
  const subBtn = document.getElementById('mobile-sub-btn');
  const subMenu = document.getElementById('mobile-sub-menu');
  const subArrow = document.getElementById('sub-arrow');

  subBtn?.addEventListener('click', () => {
    subMenu?.classList.toggle('hidden');
    subArrow?.classList.toggle('rotate-180');
  });
</script>