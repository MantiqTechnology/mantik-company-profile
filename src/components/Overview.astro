---
const items = [
  {
    tag: "01",
    title: "Why Choose Us",
    description:
      "Kami tidak hanya membangun sistem. Kami memahami proses, kebutuhan, dan tujuan bisnis untuk memastikan teknologi yang dibangun benar-benar memberikan nilai.",
    bgColor: "bg-[#1f263c]", // Dark Navy
    accentColor: "bg-sky-400",
    href: "#whyus",
  },
  {
    tag: "02",
    title: "What We Do",
    description:
      "Kami membantu mulai dari memahami kebutuhan, merancang solusi, mengembangkan sistem, mengintegrasikan teknologi, hingga melakukan improvement secara berkelanjutan.",
    bgColor: "bg-[#851919]", // Crimson Red khas Mantik
    accentColor: "bg-rose-400",
    href: "/what-we-do",
  },
  {
    tag: "03",
    title: "Our Solutions",
    description:
      "Mulai dari sistem bisnis dan platform digital hingga integrasi, automation, data, dan teknologi modern, kami membangun solusi sesuai kebutuhan organisasi.",
    bgColor: "bg-[#252528]", // Dark Charcoal
    accentColor: "bg-zinc-400",
    href: "/solusi",
  },
];
---

<section class="relative z-20 w-full overflow-hidden">
  <div class="grid grid-cols-1 md:grid-cols-3 w-full">
    {items.map((item) => (
      <a
        href={item.href}
        class={`group relative ${item.bgColor} px-8 py-14 sm:px-12 sm:py-20 lg:px-16 lg:py-24 flex flex-col justify-between transition-all duration-500 ease-out hover:-translate-y-2 hover:shadow-2xl hover:z-30 cursor-pointer overflow-hidden`}
      >
        <!-- Garis Aksen Halus di Atas (Animasi mekar saat hover) -->
        <div class="absolute top-0 left-0 w-full h-[3px] bg-white/10">
          <div class={`h-full w-0 group-hover:w-full transition-all duration-700 ease-out ${item.accentColor}`} />
        </div>

        <!-- Bagian Atas: Tag Angka & Judul -->
        <div>
          <span class="text-md font-mono tracking-widest text-white/40 block mb-6 transition-colors duration-300 group-hover:text-white/70">
            {item.tag} 
          </span>

          <h2 class="text-2xl sm:text-3xl font-medium tracking-tight text-white mb-6 leading-snug">
            {item.title}
          </h2>

          <!-- Deskripsi (Font bersih dan tidak tebal) -->
          <p class="text-[14px] sm:text-[15px] font-light text-zinc-200/85 leading-relaxed tracking-normal">
            {item.description}
          </p>
        </div>

        <!-- Bagian Bawah: Aksen Panah Eksplorasi (Meluncur halus saat hover) -->
        <div class="mt-12 flex items-center gap-2 text-xs uppercase tracking-wider font-medium text-white/60 group-hover:text-white transition-all duration-300">
          <span>Pelajari Selengkapnya</span>
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            class="h-4 w-4 transform transition-transform duration-300 group-hover:translate-x-1.5" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor" 
            stroke-width="1.75"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>

        <!-- Efek Kilau Halus di Pojok Belakang saat Hover -->
        <div class="absolute -right-16 -bottom-16 w-40 h-40 rounded-full bg-white/5 blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none" />
      </a>
    ))}
  </div>
</section>