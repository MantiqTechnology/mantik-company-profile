---
---

<section id="about" class="relative py-24 lg:py-32 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Kolom Kiri: Komposisi Gambar & Aksen Kotak Merah -->
      <div class="lg:col-span-5 relative flex justify-center lg:justify-start">
        <div class="relative w-full max-w-md lg:max-w-none">
          
          <!-- Balok Merah Kiri Atas -->
          <div class="absolute -top-6 -left-6 sm:-top-8 sm:-left-8 w-36 sm:w-48 h-20 sm:h-24 bg-[#851919] z-0"></div>

          <!-- Gambar Utama -->
          <div class="relative z-10 overflow-hidden shadow-lg bg-zinc-100 group">
            <img
              src="https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=1000&auto=format&fit=crop"
              alt="Mantik Team Discussion"
              class="w-full h-[380px] sm:h-[420px] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </div>

          <!-- Balok Merah Kanan Bawah -->
          <div class="absolute -bottom-6 -right-6 sm:-bottom-8 sm:-right-8 w-40 sm:w-52 h-20 sm:h-24 bg-[#851919] z-0"></div>

        </div>
      </div>

      <!-- Kolom Kanan: Konten Teks -->
      <div class="lg:col-span-7 flex flex-col items-start lg:pl-6">
        
        <!-- Badge Tag -->
        <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-[#fcedec] border border-[#f5d0cf] mb-6">
          <span class="text-xs sm:text-[13px] font-medium text-[#851919]">
            About mantik
          </span>
        </div>

        <!-- Judul Utama (Warna Merah Mantik, font-medium) -->
        <h2 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-bold text-[#851919] leading-[1.25] tracking-tight mb-6">
          We Understand Business Before We Build Technology
        </h2>

        <!-- Deskripsi Paragraf -->
        <p class="text-[15px] sm:text-base font-normal text-zinc-700 leading-relaxed mb-8">
          PT Mantik Teknologi Nusantara adalah technology solutions partner yang membantu perusahaan dan organisasi mengubah kebutuhan bisnis menjadi solusi digital yang relevan, terintegrasi, dan berdampak. Kami memahami bisnis terlebih dahulu sebelum membangun teknologi, karena teknologi yang tepat bukan sekadar bekerja, tetapi menciptakan nilai dan mendorong pertumbuhan.
        </p>

        <!-- Tombol Outline dengan Efek Geser Panah -->
        <a
          href="#cta"
          class="group inline-flex items-center gap-3 px-6 py-3 border border-[#851919] text-[#851919] text-sm font-medium tracking-wide transition-all duration-300 hover:bg-[#851919] hover:text-white shadow-xs"
        >
          <span>Mulai Konsultasi</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 transform transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

      </div>

    </div>
  </div>
</section>